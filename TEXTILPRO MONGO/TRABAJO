  "lotes_registrados": {
    $elemMatch: {
      "turno": "Mañana",
      "estado_lote": "Terminado"
    }
  }
});

db["lotes"].aggregate([
  { $unwind: "$lotes_registrados" },
  { $unwind: "$lotes_registrados.pruebas_resistencia" },
  {
    $match: {
      $expr: {
        $lt: [
          "$lotes_registrados.pruebas_resistencia.resultado_obtenido",
          "$lotes_registrados.pruebas_resistencia.minimo_exigido"
        ]
      }
    }
  }
]);

db["lotes"].find({
  "lotes_registrados": {
    $elemMatch: {
      $or: [
        { "pruebas_calidad": { $exists: false } },
        { "pruebas_calidad": { $size: 0 } }
      ]
    }
  }
});

db["lotes"].aggregate([
  { $unwind: "$lotes_registrados" },
  { $sort: { "lotes_registrados.porcentaje_desperdicio": -1 } },
  { $limit: 5 },
  {
    $project: {
      _id: 0,
      codigo_lote: "$lotes_registrados.codigo_lote",
      nombre_producto: "$lotes_registrados.nombre_producto",
      porcentaje_desperdicio: "$lotes_registrados.porcentaje_desperdicio"
    }
  }
]);